    "No reminders will be sent. Items keep their reminder setting and resume when you turn this back on." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো রিমাইন্ডার পাঠানো হবে না। আইটেমগুলোর সেটিং থেকে যাবে এবং আবার চালু করলে আগের মতো চলবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden keine Erinnerungen gesendet. Einträge behalten ihre Einstellung und werden fortgesetzt, sobald du dies wieder aktivierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se enviarán recordatorios. Los elementos conservan su ajuste y se reanudarán cuando vuelvas a activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun rappel ne sera envoyé. Les éléments conservent leur réglage et reprennent quand vous réactivez cette option."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーは送信されません。各項目の設定は保持され、オンに戻すと再開されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum lembrete será enviado. Os itens mantêm a configuração e voltam quando você reativar esta opção."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会发送任何提醒。各项目会保留提醒设置，重新开启后即可恢复。"
          }
        }
      }
