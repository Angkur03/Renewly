            "value" : "你的数据保留在此设备上。无需账户。"
          }
        }
      }
    },
    "Your details were kept. Nothing new was found on the photo." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার তথ্য রাখা হয়েছে। ছবিতে নতুন কিছু পাওয়া যায়নি।"
          }
        },
        "de" : {
