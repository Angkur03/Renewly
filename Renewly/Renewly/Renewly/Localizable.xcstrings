    "The free plan covers up to %lld items. Pro adds unlimited items and 30, 3 and 1 day alerts." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফ্রি প্ল্যানে সর্বোচ্চ %lldটি আইটেম। Pro-তে সীমাহীন আইটেম এবং ৩০, ৩ ও ১ দিন আগের অ্যালার্ট।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kostenlose Plan umfasst bis zu %lld Einträge. Pro bietet unbegrenzte Einträge und Hinweise 30, 3 und 1 Tag vorher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan gratuito cubre hasta %lld elementos. Pro añade elementos ilimitados y avisos a 30, 3 y 1 día."
          }
        },
        "fr" : {
          "stringUnit" : {
