    "Save any item with its receipt or warranty card as a PDF to print or share." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোনো আইটেম রসিদ বা ওয়ারেন্টি কার্ডসহ PDF হিসেবে সেভ করে প্রিন্ট বা শেয়ার করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere jeden Eintrag mit Beleg oder Garantiekarte als PDF zum Drucken oder Teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda cualquier elemento con su recibo o tarjeta de garantía como PDF para imprimirlo o compartirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un élément avec son reçu ou sa carte de garantie en PDF pour l’imprimer ou le partager."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目をレシートや保証書と一緒にPDFで保存して、印刷や共有ができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve qualquer item com o recibo ou cartão de garantia em PDF para imprimir ou compartilhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将任意项目连同收据或保修卡保存为 PDF，便于打印或分享。"
          }
        }
      }
    },
    "Saved, but reminders are off. %@" : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেভ হয়েছে, তবে রিমাইন্ডার বন্ধ। %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichert, aber Erinnerungen sind aus. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado, pero los recordatorios están desactivados. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré, mais les rappels sont désactivés. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しましたが、リマインダーはオフです。%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo, mas os lembretes estão desativados. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存，但提醒已关闭。%@"
          }
        }
      }
    },
    "Saves every item and receipt photo to one file. Store it in iCloud Drive or Files to move to a new iPhone. Restoring only adds items, it never deletes or overwrites." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সব আইটেম ও রসিদের ছবি একটি ফাইলে সেভ করে। নতুন iPhone-এ নিতে এটি iCloud Drive বা Files-এ রাখুন। পুনরুদ্ধার শুধু আইটেম যোগ করে, কখনো মুছে বা বদলে দেয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert alle Einträge und Belegfotos in einer Datei. Lege sie in iCloud Drive oder „Dateien“ ab, um auf ein neues iPhone umzuziehen. Beim Wiederherstellen wird nur hinzugefügt, nie gelöscht oder überschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todos los elementos y fotos de recibos en un archivo. Guárdalo en iCloud Drive o Archivos para pasarlo a un iPhone nuevo. Restaurar solo añade elementos; nunca borra ni sobrescribe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre tous les éléments et photos de reçus dans un fichier. Conservez-le dans iCloud Drive ou Fichiers pour passer à un nouvel iPhone. La restauration ajoute seulement des éléments, sans jamais supprimer ni écraser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての項目とレシート写真を1つのファイルに保存します。新しいiPhoneに移すにはiCloud Driveや「ファイル」に保管してください。復元は項目を追加するだけで、削除や上書きはしません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva todos os itens e fotos de recibos em um arquivo. Guarde-o no iCloud Drive ou no app Arquivos para passar para um novo iPhone. Restaurar apenas adiciona itens; nunca apaga nem substitui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有项目和收据照片保存到一个文件中。存放在 iCloud 云盘或“文件”中，即可迁移到新 iPhone。恢复只会添加项目，不会删除或覆盖。"
          }
        }
      }
    },
