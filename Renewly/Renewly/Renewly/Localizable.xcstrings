    "7-day reminders for up to %lld items. Try Pro free for 7 days: unlimited reminders, insights and PDF export." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সর্বোচ্চ %lldটি আইটেমের জন্য ৭ দিন আগের রিমাইন্ডার। ৭ দিন ফ্রিতে Pro ব্যবহার করুন: সীমাহীন রিমাইন্ডার, বিশ্লেষণ ও PDF এক্সপোর্ট।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-Tage-Erinnerungen für bis zu %lld Einträge. Teste Pro 7 Tage kostenlos: unbegrenzte Erinnerungen, Auswertungen und PDF-Export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordatorios a 7 días para hasta %lld elementos. Prueba Pro gratis 7 días: recordatorios ilimitados, estadísticas y exportación a PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappels à 7 jours pour %lld éléments maximum. Essayez Pro gratuitement pendant 7 jours : rappels illimités, statistiques et export PDF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大%lld件まで7日前にリマインド。Proを7日間無料で試す：無制限のリマインダー、分析、PDF書き出し。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembretes de 7 dias para até %lld itens. Teste o Pro grátis por 7 dias: lembretes ilimitados, análises e exportação em PDF."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多 %lld 项提前 7 天提醒。免费试用 Pro 7 天：无限提醒、支出分析和 PDF 导出。"
          }
        }
      }
    },
