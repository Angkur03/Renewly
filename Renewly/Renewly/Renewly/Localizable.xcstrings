    "Auto-renews at %@ until cancelled. Cancel anytime in Settings at least 24 hours before the end of the current period." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাতিল না করা পর্যন্ত %@ হারে স্বয়ংক্রিয়ভাবে নবায়ন হবে। বর্তমান মেয়াদ শেষের অন্তত ২৪ ঘণ্টা আগে সেটিংসে যেকোনো সময় বাতিল করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch zu %@, bis du kündigst. Kündige jederzeit in den Einstellungen, mindestens 24 Stunden vor Ende des aktuellen Zeitraums."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente a %@ hasta que la canceles. Cancela cuando quieras en Ajustes al menos 24 horas antes de que termine el período actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique à %@ jusqu’à résiliation. Résiliez à tout moment dans Réglages au moins 24 heures avant la fin de la période en cours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解約するまで%@で自動更新されます。現在の期間が終わる24時間前までに「設定」からいつでも解約できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova automaticamente por %@ até ser cancelada. Cancele quando quiser em Ajustes, pelo menos 24 horas antes do fim do período atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将以 %@ 自动续订，直至取消。可随时在“设置”中取消，但需在当前周期结束前至少 24 小时操作。"
          }
        }
      }
    },
