    "Coverage has ended. Keep the receipt in case the retailer offers goodwill repairs." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কভারেজ শেষ হয়েছে। বিক্রেতা সৌজন্য মেরামতের সুযোগ দিলে কাজে লাগাতে রসিদটি রেখে দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Garantie ist abgelaufen. Bewahre den Beleg auf, falls der Händler Kulanzreparaturen anbietet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cobertura ha terminado. Guarda el recibo por si la tienda ofrece reparaciones de cortesía."
