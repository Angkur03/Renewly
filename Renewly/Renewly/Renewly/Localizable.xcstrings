    "You have no subscriptions in %@. Items in other currencies aren't added up." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ আপনার কোনো সাবস্ক্রিপশন নেই। অন্য মুদ্রার আইটেম যোগ করা হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast keine Abos in %@. Einträge in anderen Währungen werden nicht addiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes suscripciones en %@. Los elementos en otras monedas no se suman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez aucun abonnement en %@. Les éléments dans d’autres devises ne sont pas additionnés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のサブスクはありません。他の通貨の項目は合計されません。"
